# photo-sorter sample environment file (Debian/Ubuntu .deb install)
#
# This file is a dpkg conffile (type: config|noreplace). Operator edits
# are preserved across upgrades. After upgrading photo-sorter, diff
# this file against /etc/photo-sorter/photo-sorter.env.dpkg-dist to
# pick up any newly added options.
#
# The authoritative list of every supported environment variable lives
# in the project's CLAUDE.md:
#   https://github.com/kozaktomas/photo-sorter/blob/main/CLAUDE.md
#
# Book typography note: Bookman Old Style is proprietary and is NOT
# bundled with the .deb. The PDF book export still works without it;
# only typography presets that select Bookman Old Style degrade. See
# the "Bookman Old Style" note in scripts/install-fonts.sh for the
# manual install path.

# ─── Database (REQUIRED) ─────────────────────────────────────────────
# Postgres 15+ with the `vector` extension (pgvector) installed.
# DATABASE_URL=postgres://photosorter:CHANGEME@localhost:5432/photosorter?sslmode=disable
# DATABASE_MAX_OPEN_CONNS=25
# DATABASE_MAX_IDLE_CONNS=5

# ─── Bootstrap admin (REQUIRED on first install) ─────────────────────
# Auto-creates the first admin user on a fresh database. No-op once any
# user exists. If both vars are unset on a fresh install, the server
# logs a WARN and starts anyway — create the first user manually via
# /api/v1/users/* or the Settings page.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=change-me

# ─── Storage paths ───────────────────────────────────────────────────
# Originals live as YYYY/MM/<filename>; cache holds thumbnails under
# thumb/<aa>/<bb>/<cc>/<hash>_<size>.jpg. The deb postinstall creates
# both dirs under /var/lib/photo-sorter owned by the photo-sorter user.
STORAGE_ORIGINALS_PATH=/var/lib/photo-sorter/originals
STORAGE_CACHE_PATH=/var/lib/photo-sorter/cache

# ─── Web server ──────────────────────────────────────────────────────
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Secret used to sign session cookies. STRONGLY recommended in production —
# the server logs a WARN at startup if unset.
# WEB_SESSION_SECRET=change-me-to-a-long-random-string
# WEB_ALLOWED_ORIGINS=https://photos.example.com

# ─── AI providers (configure at least one for the sort + text AI features) ───
# OPENAI_TOKEN=sk-...
# GEMINI_API_KEY=...

# ─── Local AI (optional) ─────────────────────────────────────────────
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2-vision:11b
# LLAMACPP_URL=http://localhost:8080
# LLAMACPP_MODEL=llava

# ─── Embeddings service ──────────────────────────────────────────────
# External service exposing POST /embed/image and POST /embed/text
# (CLIP + InsightFace). Required for similarity search, face recognition,
# duplicate detection, and era estimation.
# EMBEDDING_URL=http://localhost:8000
# EMBEDDING_DIM=768

# ─── Duplicate detection on upload ───────────────────────────────────
# DUPLICATE_CHECK_ENABLED=true
# DUPLICATE_PHASH_MAX_DIFF=8
# DUPLICATE_EMBEDDING_MAX_DIST=0.05

# ─── Trash auto-purge ────────────────────────────────────────────────
# Archived photos older than TRASH_RETENTION_DAYS are hard-deleted by
# the hourly background sweeper.
# TRASH_RETENTION_DAYS=30

# ─── MCP server (AI agent integration) ───────────────────────────────
# When set, MCP endpoints are mounted at /mcp/sse and /mcp/message on the
# same HTTP server. Clients authenticate via Authorization: Bearer <token>.
# MCP_API_TOKEN=
